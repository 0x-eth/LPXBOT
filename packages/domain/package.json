{
  "name": "@lpbot/domain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Domain rules boundary shared by LPBot services.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./monitor-evaluator": {
      "types": "./dist/monitor-evaluator.d.ts",
      "import": "./dist/monitor-evaluator.js",
      "default": "./dist/monitor-evaluator.js"
    },
    "./execution-plans": {
      "types": "./dist/execution-plans.d.ts",
      "import": "./dist/execution-plans.js",
      "default": "./dist/execution-plans.js"
    },
    "./wallet-transfer": {
      "types": "./dist/wallet-transfer.d.ts",
      "import": "./dist/wallet-transfer.js",
      "default": "./dist/wallet-transfer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lpbot/api-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  }
}
