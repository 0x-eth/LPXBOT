    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
    />
    <link rel="icon" href="/icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <!-- chunk 加载失败自救：必须排在所有脚本之前，否则来不及注册捕获监听。
         自建部署只保留一份构建产物，每次部署 chunk 文件名变化，旧 HTML 引用旧
         chunk 会 404 → 白屏；带一次性参数回源重进（详见原理注释于 git 历史 app/layout.js）。 -->
    <script>
      (function () {
        var KEY = 'lp_bot_chunk_reload_at';
        var COOLDOWN_MS = 60000;

        function recover() {
          try {
            var last = parseInt(sessionStorage.getItem(KEY) || '0', 10);
            if (Date.now() - last < COOLDOWN_MS) return;
            sessionStorage.setItem(KEY, String(Date.now()));
          } catch (e) {
            return;
          }
          try {
            var u = new URL(window.location.href);
            u.searchParams.set('_cb', Date.now().toString(36));
            window.location.replace(u.toString());
          } catch (e) {
            window.location.reload();
          }
        }

        // 静态 chunk 的 <script>/<link> 404（Vite 产物在 /assets/ 下）
        window.addEventListener(
          'error',
          function (e) {
            var t = e && e.target;
            var src = t && (t.src || t.href);
            if (
              t &&
              (t.tagName === 'SCRIPT' || t.tagName === 'LINK') &&
              typeof src === 'string' &&
              src.indexOf('/assets/') !== -1
            )
              recover();
          },
          true
        );

        // 动态 import() 的 chunk 失败走 Promise 拒绝
        window.addEventListener('unhandledrejection', function (e) {
          var r = e && e.reason;
          if (!r) return;
          if (
            r.name === 'ChunkLoadError' ||
            /Loading (CSS )?chunk|dynamically imported module/i.test(r.message || '')
          )
            recover();
        });

        // Vite preload helper 失败时派发的专用事件。上面两条都有覆盖不到的洞：
        // 不支持 <link rel=modulepreload> 的浏览器（iOS Safari < 17）走 fetch polyfill，
        // 404 不产生 LINK error；React.lazy 又会消费掉 rejection，进不了 unhandledrejection。
        // 少了这条，旧页面点懒加载对话框/钱包会直接砸进全屏 ErrorBoundary。
        window.addEventListener('vite:preloadError', function (e) {
          if (e && typeof e.preventDefault === 'function') e.preventDefault();
          recover();
        });

        try {
          var cur = new URL(window.location.href);
          if (cur.searchParams.has('_cb')) {
            cur.searchParams.delete('_cb');
            window.history.replaceState(null, '', cur.pathname + cur.search + cur.hash);
          }
        } catch (e) {}
      })();
    </script>
    <!-- Telegram Web App SDK：必须同步加载——组件挂载时就要读 window.Telegram.WebApp
         （initData 决定是否走 TG 免登录），改 async/defer 会读到 undefined 导致登录失败 -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- 设备类型检测：桌面端加 desktop 类名 -->
    <script>
      (function () {
        var ua = navigator.userAgent || '';
        var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
        if (!isMobile) {
          document.documentElement.classList.add('desktop');
        }
      })();
    </script>
    <!-- PWA 主题色：渲染前同步读 localStorage 设置 theme-color，避免刷新闪默认色 -->
    <script>
      (function () {
        try {
          var T = {
            default: '#171717',
            blue: '#3B82F6',
            purple: '#8B5CF6',
            green: '#22C55E',
            orange: '#F97316',
            rose: '#E11D48',
            cyan: '#06B6D4',
            pink: '#EC4899',
            indigo: '#6366F1',
            amber: '#F59E0B',
            teal: '#14B8A6',
          };
          var tid = localStorage.getItem('color-theme') || 'default';
          var chx = localStorage.getItem('custom-color');
          var c = tid === 'custom' && chx ? chx : T[tid] || '#171717';
          var st = localStorage.getItem('theme');
          var dk =
            st === 'dark'
              ? true
              : st === 'light'
                ? false
                : window.matchMedia('(prefers-color-scheme: dark)').matches;
          var fc = c;
          if (dk && c !== '#171717') {
            var r = parseInt(c.slice(1, 3), 16) / 255;
            var g = parseInt(c.slice(3, 5), 16) / 255;
            var b = parseInt(c.slice(5, 7), 16) / 255;
            var mx = Math.max(r, g, b),
              mn = Math.min(r, g, b),
              h = 0;
            if (mx !== mn) {
              var d = mx - mn;
              if (mx === r) h = ((g - b) / d + (g < b ? 6 : 0)) / 6;
              else if (mx === g) h = ((b - r) / d + 2) / 6;
              else h = ((r - g) / d + 4) / 6;
            }
            h = Math.round(h * 360);
            var s2 = 0.4,
              l2 = 0.08,
              a2 = s2 * Math.min(l2, 1 - l2);
            var f = function (n) {
              var k = (n + h / 30) % 12;
              return Math.round(255 * (l2 - a2 * Math.max(Math.min(k - 3, 9 - k, 1), -1)))
                .toString(16)
                .padStart(2, '0');
            };
            fc = '#' + f(0) + f(8) + f(4);
          } else if (dk) {
            fc = '#1a1a1a';
          }
          var m = document.createElement('meta');
          m.name = 'theme-color';
          m.content = fc;
          document.head.appendChild(m);
        } catch (e) {}
      })();
    </script>
    <!-- 移动端调试面板（?debug=1 启用，?debug=0 关闭） -->
    <script>
      (function () {
        try {
          var url = new URL(window.location.href);
          var flag = url.searchParams.get('debug');
          if (flag === '1') localStorage.setItem('lp_bot_debug', '1');
          else if (flag === '0') localStorage.removeItem('lp_bot_debug');
          if (localStorage.getItem('lp_bot_debug') !== '1') return;
          var s = document.createElement('script');
          s.src = 'https://cdn.jsdelivr.net/npm/eruda@3';
          s.crossOrigin = 'anonymous';
          s.onload = function () {
            try {
              window.eruda && window.eruda.init();
            } catch (e) {}
          };
          document.head.appendChild(s);
        } catch (e) {}
      })();
    </script>
