    }
  ],
  "dtos": [
    {
      "id": "Wallet",
      "direction": "read-only",
      "fields": [
        { "name": "walletId", "type": "opaque-id", "direction": "read-only" },
        { "name": "name", "type": "string-1-80", "direction": "read-only" },
        { "name": "address", "type": "evm-address", "direction": "read-only" },
        { "name": "mode", "type": "server-kek-or-user-password", "direction": "read-only" },
        { "name": "lockStatus", "type": "wallet-lock-status", "direction": "read-only" },
        { "name": "envelopeVersion", "type": "positive-integer", "direction": "read-only" },
        { "name": "revision", "type": "positive-integer", "direction": "read-only" },
        { "name": "createdAt", "type": "timestamp", "direction": "read-only" },
        { "name": "updatedAt", "type": "timestamp", "direction": "read-only" }
      ]
    },
    {
      "id": "WalletImportWrite",
      "direction": "write-only-secret-bearing",
      "fields": [
        { "name": "name", "type": "string-1-80", "direction": "write-only" },
        { "name": "mode", "type": "server-kek-or-user-password", "direction": "write-only" },
        { "name": "privateKey", "type": "secp256k1-private-key", "direction": "write-only", "secret": true },
        { "name": "password", "type": "password", "direction": "write-only", "secret": true, "requiredWhen": "mode=user-password" }
      ]
    },
    {
      "id": "WalletGenerateWrite",
      "direction": "write-only",
      "fields": [
        { "name": "name", "type": "string-1-80", "direction": "write-only" },
        { "name": "mode", "type": "server-kek-or-user-password", "direction": "write-only" },
        { "name": "password", "type": "password", "direction": "write-only", "secret": true, "requiredWhen": "mode=user-password" }
      ]
    },
    {
      "id": "WalletBalance",
      "direction": "read-only",
      "fields": [
        { "name": "chainId", "type": "positive-integer", "direction": "read-only" },
        { "name": "walletId", "type": "opaque-id", "direction": "read-only" },
        { "name": "assetAddress", "type": "native-or-evm-address", "direction": "read-only" },
        { "name": "balanceBaseUnits", "type": "decimal-base-unit-string", "direction": "read-only", "monetary": true },
        { "name": "decimals", "type": "integer-0-255", "direction": "read-only" },
        { "name": "usdValueDecimal", "type": "nullable-canonical-decimal-string", "direction": "read-only" },
        { "name": "priceStatus", "type": "available-missing-stale", "direction": "read-only" },
        { "name": "blockNumber", "type": "decimal-base-unit-string", "direction": "read-only", "monetary": true }
      ]
    },
    {
      "id": "WalletToken",
      "direction": "read-only",
      "fields": [
        { "name": "chainId", "type": "positive-integer", "direction": "read-only" },
        { "name": "tokenAddress", "type": "evm-address", "direction": "read-only" },
        { "name": "symbol", "type": "string", "direction": "read-only" },
        { "name": "name", "type": "string", "direction": "read-only" },
        { "name": "decimals", "type": "integer-0-255", "direction": "read-only" },
        { "name": "balanceBaseUnits", "type": "decimal-base-unit-string", "direction": "read-only", "monetary": true },
        { "name": "source", "type": "default-or-user-imported", "direction": "read-only" },
        { "name": "metadataStatus", "type": "verified-missing-conflict", "direction": "read-only" }
      ]
    },
    {
      "id": "AddressBookEntry",
      "direction": "read-only",
      "fields": [
        { "name": "entryId", "type": "opaque-id", "direction": "read-only" },
        { "name": "label", "type": "string-1-80", "direction": "read-only" },
        { "name": "address", "type": "evm-address", "direction": "read-only" },
        { "name": "addressKind", "type": "own-wallet-known-external-new-external", "direction": "read-only" },
        { "name": "revision", "type": "positive-integer", "direction": "read-only" }
      ]
    },
    {
      "id": "AddressBookWrite",
      "direction": "write-only",
      "fields": [
        { "name": "label", "type": "string-1-80", "direction": "write-only" },
        { "name": "address", "type": "evm-address", "direction": "write-only" },
        { "name": "securityPassword", "type": "password", "direction": "write-only", "secret": true, "requiredWhen": "addressKind=new-external" }
      ]
    },
    {
      "id": "WalletReceiveQr",
      "direction": "read-only",
      "fields": [
        { "name": "walletId", "type": "opaque-id", "direction": "read-only" },
        { "name": "address", "type": "evm-address", "direction": "read-only" },
        { "name": "chainId", "type": "positive-integer", "direction": "read-only" },
        { "name": "assetAddress", "type": "nullable-evm-address", "direction": "read-only" },
        { "name": "amountBaseUnits", "type": "decimal-base-unit-string", "direction": "read-only", "monetary": true },
        { "name": "payload", "type": "EIP-681-uri", "direction": "read-only" },
        { "name": "qrEncoding", "type": "UTF-8-QR-M", "direction": "read-only" }
      ]
    },
    {
      "id": "SecurityPasswordWrite",
      "direction": "write-only-secret-bearing",
      "fields": [
        { "name": "oldPassword", "type": "nullable-password", "direction": "write-only", "secret": true },
        { "name": "newPassword", "type": "password", "direction": "write-only", "secret": true },
        { "name": "expectedVersion", "type": "nonnegative-integer", "direction": "write-only" }
      ]
    },
    {
      "id": "KeystorePasswordCreateWrite",
      "direction": "write-only-secret-bearing",
      "fields": [
        { "name": "newPassword", "type": "password", "direction": "write-only", "secret": true }
      ]
    },
    {
      "id": "KeystorePasswordChangeWrite",
      "direction": "write-only-secret-bearing",
      "fields": [
        { "name": "oldPassword", "type": "password", "direction": "write-only", "secret": true },
        { "name": "newPassword", "type": "password", "direction": "write-only", "secret": true },
        { "name": "expectedVersion", "type": "positive-integer", "direction": "write-only" }
      ]
    },
    {
      "id": "KeystoreUnlockWrite",
      "direction": "write-only-secret-bearing",
      "fields": [
        { "name": "password", "type": "password", "direction": "write-only", "secret": true }
      ]
    },
    {
      "id": "KeystoreSecretStatus",
      "direction": "read-only",
      "fields": [
        { "name": "configured", "type": "boolean", "direction": "read-only" },
        { "name": "version", "type": "positive-integer", "direction": "read-only" },
        { "name": "status", "type": "secret-status", "direction": "read-only" }
      ]
    },
    {
      "id": "NativeTransferPreview",
      "direction": "read-only",
      "fields": [
