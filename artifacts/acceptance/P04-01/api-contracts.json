      "success": { "status": 200, "body": "KeystoreStatus" },
      "errors": ["INVALID_AUTO_LOCK", "SECRET_VERSION_CONFLICT", "UNAUTHENTICATED"]
    },
    {
      "id": "keystore-password-create",
