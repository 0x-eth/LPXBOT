{
  "schemaVersion": 1,
  "contractVersion": "wallet-api/local-v1",
  "workItemId": "P04-01",
  "implementationStatus": "planned",
  "evidenceLevel": "locally-defined",
  "authentication": "session-required",
  "ownership": {
    "authority": "authenticated-user-id",
    "scope": "all wallet, token, address-book, keystore, password, and transfer reads and writes",
    "crossUserAccess": "deny-not-found",
    "adminOverride": false,
    "reauthenticationRequiredFor": [
      "wallet import",
      "wallet generation",
      "wallet force delete",
      "mode switch",
      "password change or reset",
      "transfer submission",
      "OKX key mutation"
    ]
  },
  "wireRules": {
    "mediaType": "application/json",
    "unknownFields": "reject",
    "timestamps": "RFC3339 UTC with Z",
    "amounts": "unsigned-canonical-base-10-base-unit-strings-only",
    "amountPattern": "^(0|[1-9][0-9]*)$",
    "floatingPointAmounts": "forbidden",
    "tokenDecimals": "integer 0..255 from versioned chain metadata",
    "identifiers": "opaque strings",
    "addresses": "0x-prefixed 20-byte EVM address; lowercase identity and EIP-55 display",
    "chainId": "positive safe integer",
    "cacheControl": "no-store",
    "requestBodyLimitBytes": 16384,
    "errorEnvelope": {
      "requiredFields": ["code", "message", "requestId", "retryable"],
      "secretFields": "forbidden",
      "providerErrorBody": "forbidden"
    }
  },
  "secretReadPolicy": {
    "resources": ["keystore password", "security password", "OKX key"],
    "returnedFields": "configured-version-status-only",
    "maskedSecretFragments": false,
    "hashOrFingerprintReturned": false,
    "writeResponseMayRepeatSecret": false,
    "failureResponseMayRepeatInput": false
  },
  "concurrency": {
    "metadataMutations": "expectedRevision-required",
    "secretMutations": "expectedVersion-required",
    "transfers": "Idempotency-Key-required",
    "conflictStatus": 409
  },
  "endpoints": [
    {
      "id": "wallet-list",
      "method": "GET",
      "path": "/api/wallets",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "success": { "status": 200, "body": "WalletPage" },
      "errors": ["INVALID_QUERY", "UNAUTHENTICATED", "SERVICE_UNAVAILABLE"]
    },
    {
      "id": "wallet-import",
      "method": "POST",
      "path": "/api/wallets/import",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "WalletImportWrite",
      "secretIngress": "dedicated-opaque-stream",
      "success": { "status": 201, "body": "Wallet" },
      "errors": ["INVALID_PRIVATE_KEY", "WALLET_ADDRESS_EXISTS", "INVALID_MODE", "REAUTH_REQUIRED", "UNAUTHENTICATED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "wallet-generate",
      "method": "POST",
      "path": "/api/wallets/generate",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "WalletGenerateWrite",
      "success": { "status": 201, "body": "Wallet" },
      "errors": ["INVALID_MODE", "WALLET_LIMIT_EXCEEDED", "REAUTH_REQUIRED", "UNAUTHENTICATED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "wallet-get",
      "method": "GET",
      "path": "/api/wallets/:walletId",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "success": { "status": 200, "body": "Wallet" },
      "errors": ["WALLET_NOT_FOUND", "UNAUTHENTICATED"]
    },
    {
      "id": "wallet-update",
      "method": "PATCH",
      "path": "/api/wallets/:walletId",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "WalletPatch with expectedRevision",
      "success": { "status": 200, "body": "Wallet" },
      "errors": ["INVALID_NAME", "WALLET_NOT_FOUND", "REVISION_CONFLICT", "UNAUTHENTICATED"]
    },
    {
      "id": "wallet-delete",
      "method": "DELETE",
      "path": "/api/wallets/:walletId",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "WalletDelete with expectedRevision, previewToken, force, and optional confirmationPhrase",
      "success": { "status": 204, "body": null },
      "errors": ["WALLET_NOT_FOUND", "WALLET_HAS_DEPENDENCIES", "WALLET_HAS_ASSETS", "PREVIEW_EXPIRED", "CONFIRMATION_MISMATCH", "REVISION_CONFLICT", "REAUTH_REQUIRED"]
    },
    {
      "id": "wallet-encryption-mode",
      "method": "POST",
      "path": "/api/wallets/:walletId/encryption-mode",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "EncryptionModeChange with expectedRevision and expectedSecretVersion",
      "secretIngress": "dedicated-opaque-stream-when-password-required",
      "success": { "status": 202, "body": "WalletModeOperation" },
      "errors": ["WALLET_NOT_FOUND", "WALLET_LOCKED", "INVALID_MODE", "INVALID_CREDENTIALS", "REVISION_CONFLICT", "SECRET_VERSION_CONFLICT", "REAUTH_REQUIRED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "wallet-balances",
      "method": "GET",
      "path": "/api/wallets/:walletId/balances",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "query": ["chainId", "tokenAddresses", "atBlock"],
      "success": { "status": 200, "body": "WalletBalancePage" },
      "errors": ["WALLET_NOT_FOUND", "CHAIN_NOT_ALLOWED", "INVALID_TOKEN", "DATA_STALE", "READ_PROVIDER_UNAVAILABLE"]
    },
    {
      "id": "wallet-token-list",
      "method": "GET",
      "path": "/api/wallets/:walletId/tokens",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "query": ["chainId"],
      "success": { "status": 200, "body": "WalletToken[]" },
      "errors": ["WALLET_NOT_FOUND", "CHAIN_NOT_ALLOWED", "UNAUTHENTICATED"]
    },
    {
      "id": "wallet-token-import",
      "method": "POST",
      "path": "/api/wallets/:walletId/tokens",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "WalletTokenImport",
      "success": { "status": 201, "body": "WalletToken" },
      "errors": ["WALLET_NOT_FOUND", "CHAIN_NOT_ALLOWED", "INVALID_TOKEN", "TOKEN_ALREADY_IMPORTED", "TOKEN_METADATA_MISMATCH", "READ_PROVIDER_UNAVAILABLE"]
    },
    {
      "id": "wallet-token-delete",
      "method": "DELETE",
      "path": "/api/wallets/:walletId/tokens/:tokenAddress",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "query": ["chainId", "expectedRevision"],
      "success": { "status": 204, "body": null },
      "errors": ["WALLET_NOT_FOUND", "TOKEN_NOT_FOUND", "DEFAULT_TOKEN_IMMUTABLE", "REVISION_CONFLICT"]
    },
    {
      "id": "wallet-receive",
      "method": "GET",
      "path": "/api/wallets/:walletId/receive",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "query": ["chainId", "assetAddress", "amountBaseUnits"],
      "success": { "status": 200, "body": "WalletReceiveQr" },
      "errors": ["WALLET_NOT_FOUND", "CHAIN_NOT_ALLOWED", "INVALID_AMOUNT", "INVALID_TOKEN"]
    },
    {
      "id": "address-book-list",
      "method": "GET",
      "path": "/api/address-book",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "success": { "status": 200, "body": "AddressBookEntry[]" },
      "errors": ["UNAUTHENTICATED", "SERVICE_UNAVAILABLE"]
    },
    {
      "id": "address-book-create",
      "method": "POST",
      "path": "/api/address-book",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "AddressBookWrite",
      "success": { "status": 201, "body": "AddressBookEntry" },
      "errors": ["INVALID_ADDRESS", "INVALID_LABEL", "ADDRESS_ALREADY_EXISTS", "SECURITY_PASSWORD_REQUIRED", "INVALID_CREDENTIALS"]
    },
    {
      "id": "address-book-update",
      "method": "PATCH",
      "path": "/api/address-book/:entryId",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "AddressBookPatch with expectedRevision",
      "success": { "status": 200, "body": "AddressBookEntry" },
      "errors": ["ADDRESS_BOOK_ENTRY_NOT_FOUND", "INVALID_LABEL", "REVISION_CONFLICT"]
    },
    {
      "id": "address-book-delete",
      "method": "DELETE",
      "path": "/api/address-book/:entryId",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "query": ["expectedRevision"],
      "success": { "status": 204, "body": null },
      "errors": ["ADDRESS_BOOK_ENTRY_NOT_FOUND", "REVISION_CONFLICT"]
    },
    {
      "id": "security-password-status",
      "method": "GET",
      "path": "/api/security-password/status",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "success": { "status": 200, "body": "KeystoreSecretStatus" },
      "errors": ["UNAUTHENTICATED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "security-password-set-or-change",
      "method": "PUT",
      "path": "/api/security-password",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "SecurityPasswordWrite with expectedVersion",
      "secretIngress": "dedicated-opaque-stream",
      "success": { "status": 200, "body": "KeystoreSecretStatus" },
      "errors": ["INVALID_CREDENTIALS", "PASSWORD_POLICY_FAILED", "SECRET_VERSION_CONFLICT", "REAUTH_REQUIRED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "keystore-status",
      "method": "GET",
      "path": "/api/keystore/status",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "success": { "status": 200, "body": "KeystoreStatus" },
      "errors": ["UNAUTHENTICATED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "keystore-unlock",
      "method": "POST",
      "path": "/api/keystore/unlock",
      "authentication": "session-required",
      "ownerScope": "current-user",
      "implementationStatus": "planned",
      "productionRoute": false,
      "request": "KeystoreUnlockWrite",
      "secretIngress": "dedicated-opaque-stream",
      "success": { "status": 200, "body": "KeystoreStatus" },
      "errors": ["INVALID_CREDENTIALS", "LOCKED_OUT", "KEYSTORE_CORRUPTED", "REAUTH_REQUIRED", "SIGNER_UNAVAILABLE"]
    },
    {
      "id": "keystore-lock",
