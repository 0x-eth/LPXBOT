      "request": "TransferPreviewWrite",
      "success": { "status": 200, "body": "NativeTransferPreview or Erc20TransferPreview" },
      "errors": ["WALLET_NOT_FOUND", "WALLET_LOCKED", "INVALID_ADDRESS", "SELF_TRANSFER", "INVALID_AMOUNT", "INSUFFICIENT_BALANCE", "INSUFFICIENT_GAS", "TOKEN_NOT_ALLOWED", "CHAIN_NOT_ALLOWED", "SIMULATION_FAILED", "READ_PROVIDER_UNAVAILABLE"]
    },
    {
      "id": "transfer-create",
