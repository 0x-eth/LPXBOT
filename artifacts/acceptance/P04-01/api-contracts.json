      "request": "KeystorePasswordCreateWrite",
      "secretIngress": "dedicated-opaque-stream",
      "success": { "status": 200, "body": "KeystoreSecretStatus" },
      "errors": ["PASSWORD_ALREADY_CONFIGURED", "PASSWORD_POLICY_FAILED", "REAUTH_REQUIRED", "SIGNER_UNAVAILABLE"]
    },
    {
