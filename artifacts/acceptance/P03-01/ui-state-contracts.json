      "summary": ["enabledCount", "totalCount"],
      "ownership": "current user only"
    },
    {
      "id": "monitor-editor",
      "title": "Monitor",
      "requiredData": ["name", "poolKey", "windowMinutes", "conditions", "destinations"],
      "primaryActions": ["save", "cancel"],
      "concurrency": "expected revision conflict is shown without discarding local edits",
      "ownership": "current user only"
    },
    {
      "id": "notification-history",
      "title": "Notification history",
      "requiredData": [
        "deliveryId",
        "monitorId",
        "poolKey",
        "conditionSummary",
        "windowEnd",
        "createdAt",
        "deliveryStatus"
      ],
      "primaryActions": ["filter", "inspect"],
      "secretDisplay": "never",
      "ownership": "current user only"
    },
    {
      "id": "notification-preferences",
      "title": "Notification preferences",
      "requiredData": ["revision", "categoryToggles"],
      "primaryActions": ["save"],
      "binaryControls": "toggle or checkbox",
      "ownership": "current user only"
    },
    {
      "id": "destination-settings",
      "title": "Destinations",
      "requiredData": ["destinationId", "revision", "type", "name", "enabled", "redactedConfig"],
      "primaryActions": ["add", "edit", "enable", "disable", "delete", "test"],
      "secretDisplay": "write-only and never echoed",
      "ownership": "current user only"
    }
  ],
  "operationalStates": [
    {
      "id": "loading",
      "trigger": "initial or explicit refresh",
      "presentation": "stable skeleton geometry and busy status"
    },
    {
      "id": "empty",
      "trigger": "authoritative empty monitor or history page",
      "presentation": "unframed empty state with one relevant action"
    },
    {
      "id": "ready",
      "trigger": "fresh authoritative data",
      "presentation": "normal controls and timestamps"
    },
    {
      "id": "stale",
      "trigger": "last market generation exceeds the 120-second freshness budget",
      "presentation": "stale status; never show a condition as matched"
    },
    {
      "id": "not-ready",
      "trigger": "required metric, blocklist snapshot, or market projection is not ready",
      "presentation": "not-ready reason and disabled enable/test action"
    },
    {
      "id": "disabled",
      "trigger": "monitor or destination is disabled",
      "presentation": "inactive status with explicit enable action"
    },
    {
      "id": "retrying",
      "trigger": "delivery state is retry-wait",
      "presentation": "attempt count and next attempt time without response body"
    },
    {
      "id": "conflict",
      "trigger": "expected revision differs",
      "presentation": "authoritative revision plus reload/reapply actions; preserve unsaved edits"
    },
    {
      "id": "error",
      "trigger": "bounded API or local test failure",
      "presentation": "stable error code, retry when safe, no secrets or rendered payload"
    }
  ],
