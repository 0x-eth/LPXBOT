{
  "schemaVersion": 1,
  "schemaId": "p03-fixture://ssrf-policy/v1",
  "scenario": "ssrf-policy",
  "fixtureOnly": true,
  "networkAccess": false,
  "description": "Synthetic DNS and redirect transcripts covering IPv4, IPv6, mixed answers, rebinding, and hop-by-hop validation.",
  "input": {
    "cases": [
      {
        "id": "ipv4-loopback",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["127.0.0.1"]],
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET" }
      },
      {
        "id": "ipv4-private",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["10.20.30.40"]],
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET" }
      },
      {
        "id": "ipv6-loopback",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["::1"]],
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET" }
      },
      {
        "id": "ipv6-unique-local",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["fd12:3456:789a::1"]],
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET" }
      },
      {
        "id": "ipv4-mapped-ipv6-loopback",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["::ffff:127.0.0.1"]],
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET" }
      },
      {
        "id": "dns-mixed-public-private",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["93.184.216.34", "192.168.1.10"]],
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET" }
      },
      {
        "id": "dns-rebinding",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [["93.184.216.34"], ["127.0.0.1"]],
        "connectionCount": 2,
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET", "failedAt": "second-resolution" }
      },
      {
        "id": "redirect-to-private",
        "url": "https://hooks.fixture.example/start",
        "hops": [
          { "status": 307, "location": "https://internal.fixture.example/final" }
        ],
        "dnsByHost": {
          "hooks.fixture.example": ["93.184.216.34"],
          "internal.fixture.example": ["169.254.169.254"]
        },
        "expected": { "allowed": false, "error": "UNSAFE_WEBHOOK_TARGET", "failedAtHop": 1 }
      },
      {
        "id": "public-a-and-aaaa",
        "url": "https://hooks.fixture.example/event",
        "dnsAnswers": [
          ["93.184.216.34", "2606:2800:220:1:248:1893:25c8:1946"]
        ],
        "expected": { "allowed": true, "validatedAddressCount": 2 }
      },
      {
        "id": "redirect-all-public",
        "url": "https://hooks.fixture.example/start",
        "hops": [
          { "status": 307, "location": "https://edge.fixture.example/next" },
          { "status": 308, "location": "https://final.fixture.example/event" }
        ],
        "dnsByHost": {
          "hooks.fixture.example": ["93.184.216.34"],
          "edge.fixture.example": ["8.8.8.8", "2001:4860:4860::8888"],
          "final.fixture.example": ["1.1.1.1", "2606:4700:4700::1111"]
        },
        "expected": { "allowed": true, "validatedHopCount": 3, "method": "POST" }
      }
    ]
  },
  "expected": {
    "allAddressesMustPass": true,
    "validatedAddressPinned": true,
    "reresolveEachConnection": true,
    "revalidateEachRedirect": true,
    "maxRedirects": 3,
    "actualDnsQueries": 0,
    "actualNetworkCalls": 0
  }
}
