      {
        "id": "get-percent-escaping",
        "method": "GET",
        "template": "alert={{monitor.name}}&pool={{pool.key}}",
        "values": {
          "monitor.name": "A&B / ready?",
          "pool.key": "56:0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
