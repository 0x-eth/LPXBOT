{
  "schemaVersion": 1,
  "schemaId": "p03-fixture://webhook-security/v1",
  "scenario": "webhook-security",
  "fixtureOnly": true,
  "networkAccess": false,
  "description": "Offline rendering and HMAC known-answer fixtures for Webhook and Telegram messages.",
  "input": {
