        "expected": {
          "renderedQuery": "alert=A%26B%20%2F%20ready%3F&pool=56%3A0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        }
      },
      {
        "id": "post-json-escaping",
        "method": "POST",
        "template": { "message": "{{condition.summary}}" },
        "values": { "condition.summary": "Fee >= \"10\"\nready" },
        "expected": { "renderedBody": "{\"message\":\"Fee >= \\\"10\\\"\\nready\"}" }
      },
      {
        "id": "telegram-html-escaping",
        "method": "TELEGRAM",
        "template": "<b>{{monitor.name}}</b>",
        "values": { "monitor.name": "<Pool & ready>" },
        "expected": { "rendered": "<b>&lt;Pool &amp; ready&gt;</b>" }
      },
      {
        "id": "unknown-variable",
        "method": "POST",
        "template": { "value": "{{internal.secret}}" },
        "values": {},
        "expected": { "error": "UNKNOWN_TEMPLATE_VARIABLE", "networkCalls": 0 }
      },
      {
        "id": "oversize-expanded-body",
        "method": "POST",
        "template": { "value": "{{condition.summary}}" },
        "expandedBodyBytes": 65537,
        "expected": { "error": "BODY_TOO_LARGE", "networkCalls": 0 }
      }
    ],
    "signature": {
      "fixtureKey": "p03-fixture-hmac-key-material-01",
      "timestamp": "1786957800",
      "deliveryId": "delivery-fixture-0001",
      "method": "POST",
      "pathAndQuery": "/hooks/lp?source=monitor",
      "body": "{\"deliveryId\":\"delivery-fixture-0001\",\"poolKey\":\"56:0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"message\":\"Fee > 10 & ready\"}"
    }
  },
  "expected": {
