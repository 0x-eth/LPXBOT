{
  "name": "lpbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "accept:p00": "bash scripts/accept-p00.sh",
    "audit:dependencies": "pnpm audit",
    "build": "turbo run build",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:all": "pnpm check:baseline && pnpm check:traceability && pnpm check:p00 && pnpm check:docs && pnpm check:acceptance && pnpm check:p02-reference && pnpm check:p03-reference",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:p00": "node scripts/check-p00.mjs",
    "check:p01-reference": "node scripts/check-p01-reference-artifacts.mjs",
    "check:p02-reference": "node scripts/check-p02-reference-artifacts.mjs",
    "check:p03-reference": "node scripts/check-p03-reference-artifacts.mjs",
    "check:traceability": "node scripts/check-traceability.mjs",
    "capture:p02-03": "node scripts/capture-p02-03-golden.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "db:migrate": "bash scripts/db.sh migrate",
    "db:seed": "bash scripts/db.sh seed",
    "db:status": "bash scripts/db.sh status",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate:p02-03-golden": "node scripts/generate-p02-03-normalized.mjs",
    "annotate:p02-03-signs": "node scripts/annotate-p02-03-sign-evidence.mjs",
    "finalize:p01-reference": "node scripts/finalize-p01-reference-artifacts.mjs",
    "finalize:p02-reference": "node scripts/finalize-p02-reference-artifacts.mjs",
    "finalize:p03-reference": "node scripts/finalize-p03-reference-artifacts.mjs",
    "finalize:p02-03": "node scripts/finalize-p02-03-acceptance.mjs",
    "infra:down": "bash scripts/infra.sh down",
    "infra:logs": "bash scripts/infra.sh logs",
    "infra:reset": "bash scripts/infra.sh reset",
    "infra:status": "bash scripts/infra.sh status",
    "infra:up": "bash scripts/infra.sh up",
    "infra:verify": "bash scripts/infra.sh verify",
    "lint": "turbo run lint && eslint scripts tests eslint.config.mjs prettier.config.mjs vitest.config.ts --max-warnings=0",
    "test": "turbo run build && vitest run && node --test tests/governance/*.test.mjs",
    "test:contracts": "forge test -vvv",
    "test:e2e": "pnpm --filter @lpbot/web^... build && playwright test",
    "test:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:infra": "bash scripts/test-infra.sh",
    "test:postgres": "bash scripts/test-postgres.sh",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.0",
    "@eslint/js": "10.0.1",
    "@noble/hashes": "1.8.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "ajv": "6.15.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "16.4.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "viem": "2.55.16",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
