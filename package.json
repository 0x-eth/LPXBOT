{
  "name": "lpbot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "turbo run lint && eslint tests eslint.config.mjs prettier.config.mjs vitest.config.ts --max-warnings=0",
    "test": "turbo run build && vitest run",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
