{
  "name": "@lpbot/okx-connector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Isolated OKX read-only credential and egress boundary.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "start": "node dist/runner.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lpbot/api-contract": "workspace:*",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0"
  }
}
