# Local development only. Keep real overrides in the gitignored .env file.
POSTGRES_DB=lpbot
POSTGRES_USER=lpbot
POSTGRES_PASSWORD=lpbot_postgres_local_only
POSTGRES_PORT=15432
DATABASE_URL=postgresql://lpbot:lpbot_postgres_local_only@127.0.0.1:15432/lpbot?sslmode=disable

REDIS_PASSWORD=lpbot_redis_local_only
REDIS_PORT=16379
REDIS_URL=redis://:lpbot_redis_local_only@127.0.0.1:16379/0

MINIO_ROOT_USER=lpbot_local
MINIO_ROOT_PASSWORD=lpbot_minio_local_only
MINIO_BUCKET=lpbot-development
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MINIO_ENDPOINT=http://127.0.0.1:19000

ANVIL_PORT=18545
ANVIL_RPC_URL=http://127.0.0.1:18545

INFRA_WAIT_TIMEOUT_SECONDS=120
INFRA_COMMAND_TIMEOUT_SECONDS=30
