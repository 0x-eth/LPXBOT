# Local development only. Keep real overrides in the gitignored .env file.
POSTGRES_DB=lpbot
POSTGRES_USER=lpbot
POSTGRES_PASSWORD=lpbot_postgres_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lpbot:lpbot_postgres_local_only@127.0.0.1:5432/lpbot?sslmode=disable

REDIS_PASSWORD=lpbot_redis_local_only
REDIS_PORT=6379
REDIS_URL=redis://:lpbot_redis_local_only@127.0.0.1:6379/0

MINIO_ROOT_USER=lpbot_local
MINIO_ROOT_PASSWORD=lpbot_minio_local_only
MINIO_BUCKET=lpbot-development
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://127.0.0.1:9000

ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
ANVIL_RPC_URL=http://127.0.0.1:8545

INFRA_WAIT_TIMEOUT_SECONDS=120
