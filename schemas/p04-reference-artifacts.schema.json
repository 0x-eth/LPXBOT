{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lpbot.local/schemas/p04-reference-artifacts.schema.json",
  "title": "LPBot P04-01 wallet security reference artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "workItemId",
    "phase",
    "risk",
    "status",
    "featureIds",
    "capturedAt",
    "referenceBaseline",
    "scope",
    "checksumScope",
    "files",
    "references",
    "checks",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractVersion": { "const": "1.0.0" },
    "workItemId": { "const": "P04-01" },
    "phase": { "const": "P04" },
    "risk": { "const": "R0" },
    "status": { "const": "contract-frozen-with-unresolved-gaps" },
    "featureIds": { "type": "array", "maxItems": 0 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "referenceBaseline": { "const": "37cb850c149168bbfff5a98768067a1a63bff2f9" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "implementationOwnership",
        "databaseChanges",
        "businessTables",
        "productionRoutes",
        "workers",
        "signerRuntime",
        "kmsAccess",
        "productionSecrets",
        "privateKeyDecryptions",
        "transactionSignatures",
        "transactionBroadcasts",
        "externalRpcCalls"
      ],
      "properties": {
        "mode": { "const": "reference-only" },
        "implementationOwnership": { "const": "none" },
        "databaseChanges": { "const": false },
        "businessTables": { "const": false },
        "productionRoutes": { "const": false },
        "workers": { "const": false },
        "signerRuntime": { "const": false },
        "kmsAccess": { "const": false },
        "productionSecrets": { "const": false },
        "privateKeyDecryptions": { "const": 0 },
        "transactionSignatures": { "const": 0 },
        "transactionBroadcasts": { "const": 0 },
        "externalRpcCalls": { "const": 0 }
      }
    },
    "checksumScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "excludedSelfReferentialFiles", "priorAcceptance"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "excludedSelfReferentialFiles": {
          "const": ["artifact-manifest.json", "sha256sums.txt"]
        },
        "priorAcceptance": { "const": "all baseline P00-P03-04 acceptance files" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 23,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256", "mediaType", "category"],
        "properties": {
          "path": { "$ref": "#/definitions/artifactPath" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/definitions/sha256" },
          "mediaType": { "enum": ["application/json", "text/plain"] },
          "category": { "enum": ["contract", "catalog", "fixture", "check", "integrity"] }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "commit", "bytes", "sha256", "source", "classification"],
        "properties": {
          "path": { "$ref": "#/definitions/repositoryPath" },
          "commit": { "const": "37cb850c149168bbfff5a98768067a1a63bff2f9" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/definitions/sha256" },
          "source": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["PUBLIC", "BUNDLE-CANDIDATE", "INFERRED", "LOCAL-DECISION"]
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "evidencePath"],
        "properties": {
          "id": {
            "enum": [
              "initial-red",
              "governance-test",
              "artifact-schema",
              "prior-acceptance-integrity",
              "quality-gates",
              "secret-scan",
              "dependency-audit"
            ]
          },
          "result": { "enum": ["expected-failure", "passed"] },
          "evidencePath": { "$ref": "#/definitions/artifactPath" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!artifact-manifest\\.json$)(?!sha256sums\\.txt$).+$"
    }
  }
}
