{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lpbot.local/schemas/acceptance-manifest.schema.json",
  "title": "LPBot acceptance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workItemId",
    "phase",
    "risk",
    "status",
    "featureIds",
    "tests",
    "evidence",
    "assumptions",
    "completedAt",
    "commit"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workItemId": { "type": "string", "pattern": "^P\\d{2}-\\d{2}$" },
    "phase": {
      "enum": [
        "P00",
        "P01",
        "P02",
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "P09",
        "P10",
        "P11",
        "P12",
        "P13"
      ]
    },
    "risk": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "status": { "enum": ["in-progress", "accepted", "accepted-with-gaps", "failed"] },
    "featureIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d{2}$" }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result", "evidencePath"],
        "properties": {
          "id": {
            "enum": [
              "T-UNIT",
              "T-API",
              "T-SSE",
              "T-UI",
              "T-VIS",
              "T-CHAIN",
              "T-REC",
              "T-SEC",
              "T-PERF",
              "T-MIG"
            ]
          },
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["passed", "failed"] },
          "evidencePath": { "$ref": "#/definitions/repositoryPath" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path"],
        "properties": {
          "id": {
            "enum": [
              "E-UI",
              "E-VIS",
              "E-API",
              "E-SSE",
              "E-DATA",
              "E-CHAIN",
              "E-REC",
              "E-RBAC",
              "E-SEC",
              "E-OPS"
            ]
          },
          "path": { "$ref": "#/definitions/repositoryPath" }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "completedAt": {
      "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "commit": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        { "type": "null" }
      ]
    }
  },
  "definitions": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
